# Postgres (Railway or local docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plumb?schema=public"

# API
PORT=4300

# Web -> API wiring (COMPANY_ID is printed by the seed script)
NEXT_PUBLIC_API_URL="http://localhost:4300"
NEXT_PUBLIC_COMPANY_ID=""

# QuickBooks Online (Intuit developer app credentials)
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_REDIRECT_URI="http://localhost:4300/qbo/callback"
QBO_ENVIRONMENT="sandbox"

# Weekly digest email (optional). Without RESEND_API_KEY + DIGEST_FROM the digest
# endpoints and scheduler dry-run: they render the email but never send it.
RESEND_API_KEY=""
DIGEST_FROM=""                       # e.g. "Plumb <weekly@yourdomain.com>"

# Weekly-digest scheduler (node-cron). Off unless ENABLE_SCHEDULER=true.
ENABLE_SCHEDULER="false"
DIGEST_CRON="0 7 * * 1"              # Mondays 07:00
DIGEST_TEST_TO=""                    # demo recipient for scheduled sends
QBO_SYNC_CRON="0 3 * * *"           # nightly QBO sync for connected companies

# Plaid bank feed for opening cash (optional). Without PLAID_CLIENT_ID +
# PLAID_SECRET the "Connect bank" flow dry-runs with a sandbox balance.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"                  # sandbox | development | production
