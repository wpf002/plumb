{
  "name": "plumb",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @plumb/db exec prisma generate",
    "db:push": "pnpm --filter @plumb/db exec prisma db push",
    "db:seed": "pnpm --filter @plumb/db exec tsx prisma/seed.ts"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0"
  }
}
