// Plumb — subcontractor financial planning. Money is ALWAYS integer cents (BigInt).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Auth & multi-company ---------------------------------------------------

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  memberships  Membership[]
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  createdAt    DateTime     @default(now())
}

enum MemberRole {
  OWNER
  MEMBER
}

model Membership {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      MemberRole @default(OWNER)
  createdAt DateTime   @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Invitation {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  role        MemberRole @default(MEMBER)
  token       String     @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([companyId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Company {
  id                    String    @id @default(cuid())
  name                  String
  trade                 Trade     @default(GENERAL)
  employeeCount         Int       @default(0)
  // Which revenue models this business runs. Gates which modules are active:
  // PROJECT hides service contracts, RECURRING hides bid coverage. Most trades
  // are BOTH (bid work plus recurring service agreements).
  revenueModel          RevenueModel @default(BOTH)
  setupCompletedAt      DateTime?
  cashSafetyThreshold   BigInt    @default(0) // cents
  defaultRetainagePct   Float     @default(10)
  portfolioTargetMargin Float     @default(12)
  monthlyLaborHours     Int       @default(0) // crew capacity
  projects              Project[]
  cashEvents            CashEvent[]
  cashSnapshots         CashSnapshot[]
  qbo                   QboConnection?
  syncLogs              SyncLog[]
  categoryMappings      CategoryMapping[]
  assets                Asset[]
  liabilities           Liability[]
  recurringExpenses     RecurringExpense[]
  memberships           Membership[]
  invitations           Invitation[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// Per-company override: if a QBO account/item name contains `keyword`, classify
// the cost as `category`. Corrects the built-in rules per chart of accounts.
model CategoryMapping {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  keyword   String
  category  CostCategory
  createdAt DateTime     @default(now())

  @@index([companyId])
}

model Project {
  id               String            @id @default(cuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id])
  name             String
  client           String
  clientType       ClientType
  status           ProjectStatus     @default(BIDDING)
  billingType      BillingType       @default(FIXED_PRICE)
  netDays          Int               @default(30) // payment terms
  contractValue    BigInt // cents
  originalBidCost  BigInt // cents (total estimated cost at bid)
  billedToDate     BigInt            @default(0) // cents billed (for WIP over/under)
  targetMarginPct  Float
  retainagePct     Float             @default(10)
  percentComplete  Float? // 0..1, PM-entered; null => inferred from cost burn
  startDate        DateTime
  endDate          DateTime
  expectedEndDate  DateTime? // current projection if slipping (delay impact)
  qboJobId         String? // QBO Customer:Job id
  phases           Phase[]
  budgetLines      BudgetLine[]
  costs            CostEntry[]
  changeOrders     ChangeOrder[]
  cashEvents       CashEvent[]
  milestones       Milestone[]
  laborCommitments LaborCommitment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([companyId, status])
}

// Optional job phases (e.g. Rough-In, Trim, Gear). Enables phase-level costing.
model Phase {
  id          String       @id @default(cuid())
  milestones  Milestone[]
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id])
  name        String
  code        String? // cost code
  sortOrder   Int          @default(0)
  budgetLines BudgetLine[]
  costs       CostEntry[]

  @@index([projectId])
}

// Budgeted cost per category (and optionally per phase). Drives over-budget
// detection and material/labor cost-increase impact.
model BudgetLine {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id])
  phaseId       String?
  phase         Phase?       @relation(fields: [phaseId], references: [id])
  category      CostCategory
  budgetedCost  BigInt // cents
  budgetedHours Int          @default(0)

  @@index([projectId, category])
}

model CostEntry {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id])
  phaseId      String?
  phase        Phase?       @relation(fields: [phaseId], references: [id])
  category     CostCategory
  costCode     String?
  docType      DocType      @default(OTHER)
  amount       BigInt // cents
  laborHours   Float? // for LABOR entries
  vendorName   String?
  incurredDate DateTime
  source       CostSource   @default(MANUAL)
  qboId        String? // source system id, for idempotent sync
  note         String?
  createdAt    DateTime     @default(now())

  @@index([projectId, category])
  @@index([qboId])
}

model ChangeOrder {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id])
  reason        String?
  contractDelta BigInt // cents
  costDelta     BigInt // cents
  status        ChangeOrderStatus @default(PENDING)
  date          DateTime
  approvedAt    DateTime?
  createdAt     DateTime          @default(now())

  @@index([projectId, status])
}

model CashEvent {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  projectId    String?
  project      Project?      @relation(fields: [projectId], references: [id])
  direction    CashDirection
  amount       BigInt // cents, always positive; direction carries sign
  category     CashCategory
  expectedDate DateTime
  actualDate   DateTime?
  status       CashStatus    @default(EXPECTED)
  qboId        String?
  // Identity of the obligation-and-period this event settles, e.g.
  // "OVERHEAD:<id>:2026-09". A ledger event carrying a key supersedes the
  // projection with the same key — that is how projections never double-count.
  sourceKey    String?
  createdAt    DateTime      @default(now())

  @@unique([companyId, sourceKey])
  @@index([companyId, expectedDate])
  @@index([qboId])
}

// Bank balance point-in-time (manual or bank-feed synced). Opening cash source.
model CashSnapshot {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  asOf      DateTime
  balance   BigInt // cents
  source    String   @default("MANUAL")
  createdAt DateTime @default(now())

  @@index([companyId, asOf])
}

model LaborCommitment {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  month     String // YYYY-MM
  hours     Int

  @@unique([projectId, month])
}

// A contract-defined point at which the business may invoice the client. This
// is what drives a project's contribution to the cash forecast: without it the
// timing of money coming in is inferred, and a slipped date can't ripple.
model Milestone {
  id                   String            @id @default(cuid())
  projectId            String
  project              Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                 String
  sequence             Int               @default(0)
  trigger              MilestoneTrigger  @default(DATE)
  /// Percent complete (0..1) for PERCENT_COMPLETE triggers.
  triggerValue         Float?
  phaseId              String?
  phase                Phase?            @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  expectedDate         DateTime
  /// Kept so slip is measurable rather than silently overwritten.
  originalExpectedDate DateTime
  amount               BigInt // cents
  retainagePct         Float             @default(0)
  status               MilestoneStatus   @default(PLANNED)
  billedAt             DateTime?
  paidAt               DateTime?
  qboInvoiceId         String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([projectId, expectedDate])
}

// --- Balance sheet --------------------------------------------------------

// What the business owns. Tracked with enough structure to depreciate rather
// than just show sunk cost, so it can feed net worth and buy-vs-wait decisions.
model Asset {
  id               String        @id @default(cuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  category         AssetCategory
  purchaseDate     DateTime
  purchaseCost     BigInt // cents
  // Owner-entered current value. Anchors depreciation from `valueAsOf` — a
  // manual number always beats the computed one.
  currentValue     BigInt?
  valueAsOf        DateTime?
  usefulLifeMonths Int? // null => no straight-line decline, value holds flat
  salvageValue     BigInt        @default(0)
  disposedAt       DateTime?
  liabilities      Liability[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([companyId])
}

// What the business owes. Every liability carries a payment obligation, which
// `engine/schedule` expands into projected outflows — this is never a static list.
model Liability {
  id                String        @id @default(cuid())
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  lender            String?
  kind              LiabilityKind
  originalPrincipal BigInt        @default(0) // cents
  currentBalance    BigInt // cents outstanding today
  creditLimit       BigInt? // cards / lines of credit
  interestRatePct   Float         @default(0) // APR
  paymentAmount     BigInt        @default(0) // cents per period
  paymentFrequency  Frequency     @default(MONTHLY)
  nextPaymentDate   DateTime?
  payoffDate        DateTime?
  termMonths        Int?
  endDate           DateTime? // lease end
  renewalTerms      String?
  // If a synced QBO bill's vendor contains this, the actual supersedes the
  // projected payment for that period instead of double-counting it.
  matchKeyword      String?
  assetId           String? // the truck this loan bought, the building this lease rents
  asset             Asset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([companyId])
  @@index([assetId])
}

// The ordinary running costs that aren't debt: insurance, software, fuel,
// utilities, rent, non-job payroll. Deliberately simpler than Liability — this
// is the low-friction entry point for "what does it cost to open the doors".
model RecurringExpense {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  category     CashCategory @default(OVERHEAD)
  amount       BigInt // cents per occurrence
  frequency    Frequency    @default(MONTHLY)
  startDate    DateTime
  endDate      DateTime?
  matchKeyword String? // QBO vendor substring; see Liability.matchKeyword
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([companyId])
}

// --- Integrations ---------------------------------------------------------

model QboConnection {
  id           String   @id @default(cuid())
  companyId    String   @unique
  company      Company  @relation(fields: [companyId], references: [id])
  realmId      String // QBO company id
  accessToken  String
  refreshToken String
  expiresAt    DateTime // access-token expiry
  environment  String   @default("production") // or "sandbox"
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SyncLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  provider   String   @default("QBO")
  kind       String // FULL, INCREMENTAL, INVOICES, BILLS, TIME, etc.
  status     String // OK, ERROR
  counts     Json? // { invoices: 12, bills: 30, ... }
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  error      String?

  @@index([companyId, startedAt])
}

enum MilestoneTrigger {
  DATE
  PERCENT_COMPLETE
  PHASE_COMPLETE
}

enum MilestoneStatus {
  PLANNED
  READY
  BILLED
  PAID
}

enum AssetCategory {
  VEHICLE
  EQUIPMENT
  REAL_ESTATE
  TECHNOLOGY
  OTHER
}

enum LiabilityKind {
  CREDIT_CARD
  LINE_OF_CREDIT
  TERM_LOAN
  SBA_LOAN
  MORTGAGE
  EQUIPMENT_LEASE
  BUILDING_LEASE
  OTHER
}

// Shared by liabilities, recurring overhead, and service contracts.
enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum Trade {
  ELECTRICAL
  HVAC
  PLUMBING
  ROOFING
  MASONRY
  DRYWALL
  CONCRETE
  MECHANICAL
  LANDSCAPING
  GENERAL
  OTHER
}

enum RevenueModel {
  PROJECT
  RECURRING
  BOTH
}

enum ClientType {
  OWNER_DIRECT
  GC
}

enum ProjectStatus {
  BIDDING
  AWARDED
  ACTIVE
  CLOSED
}

enum BillingType {
  FIXED_PRICE
  COST_PLUS
  TIME_AND_MATERIAL
  AIA
}

enum CostCategory {
  LABOR
  MATERIAL
  EQUIPMENT
  TRAVEL
  SUBCONTRACT
  OTHER
}

enum DocType {
  INVOICE
  RECEIPT
  BILL
  PAYROLL
  MATERIAL_PO
  OTHER
}

enum CostSource {
  MANUAL
  QBO
  IMPORT
}

enum CashDirection {
  IN
  OUT
}

enum CashCategory {
  PROGRESS_BILLING
  RETAINAGE_RELEASE
  PAYROLL
  VENDOR_BILL
  OVERHEAD
  TAX
  LOAN
  INSURANCE
}

enum CashStatus {
  EXPECTED
  RECEIVED
  PAID
  LATE
}

enum ChangeOrderStatus {
  PENDING
  APPROVED
  REJECTED
}
