// Plumb — subcontractor financial planning. Money is ALWAYS integer cents (BigInt).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Auth & multi-company ---------------------------------------------------

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  memberships  Membership[]
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  createdAt    DateTime     @default(now())
}

enum MemberRole {
  OWNER
  MEMBER
}

model Membership {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      MemberRole @default(OWNER)
  createdAt DateTime   @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Invitation {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  role        MemberRole @default(MEMBER)
  token       String     @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([companyId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Company {
  id                    String    @id @default(cuid())
  name                  String
  trade                 Trade     @default(GENERAL)
  employeeCount         Int       @default(0)
  // Which revenue models this business runs. Gates which modules are active:
  // PROJECT hides service contracts, RECURRING hides bid coverage. Most trades
  // are BOTH (bid work plus recurring service agreements).
  revenueModel          RevenueModel @default(BOTH)
  setupCompletedAt      DateTime?
  cashSafetyThreshold   BigInt    @default(0) // cents
  defaultRetainagePct   Float     @default(10)
  portfolioTargetMargin Float     @default(12)
  monthlyLaborHours     Int       @default(0) // crew capacity
  // Profile fields carried by imported test accounts and onboarding.
  externalId            String?
  naicsCode             String?
  city                  String?
  state                 String?
  foundedYear           Int?
  ownerName             String?
  ownerAge              Int?
  legalStructure        String?
  accountingMethod      String?
  fiscalYearEnd         String?
  ownerSalaryCents      BigInt?
  ownerDistributionsCents BigInt?
  goals                 String?
  // Where this company's data came from: SEED, IMPORT, or QBO.
  dataSource            String    @default("SEED")
  projects              Project[]
  entities              Entity[]
  customers             Customer[]
  vendors               Vendor[]
  invoices              Invoice[]
  bills                 Bill[]
  crews                 Crew[]
  employees             Employee[]
  timeEntries           TimeEntry[]
  opportunities         Opportunity[]
  serviceCallPeriods    ServiceCallPeriod[]
  recurringRevenue      RecurringRevenueEntry[]
  budgets               Budget[]
  forecastSnapshots     ForecastSnapshot[]
  glAccounts            GlAccount[]
  valuationInput        ValuationInput?
  importRuns            ImportRun[]
  cashEvents            CashEvent[]
  cashSnapshots         CashSnapshot[]
  qbo                   QboConnection?
  syncLogs              SyncLog[]
  categoryMappings      CategoryMapping[]
  assets                Asset[]
  liabilities           Liability[]
  recurringExpenses     RecurringExpense[]
  payers                Payer[]
  serviceContracts      ServiceContract[]
  memberships           Membership[]
  invitations           Invitation[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// Per-company override: if a QBO account/item name contains `keyword`, classify
// the cost as `category`. Corrects the built-in rules per chart of accounts.
model CategoryMapping {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  keyword   String
  category  CostCategory
  createdAt DateTime     @default(now())

  @@index([companyId])
}

model Project {
  id               String            @id @default(cuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id])
  name             String
  client           String
  clientType       ClientType
  payerId          String?
  payer            Payer?            @relation(fields: [payerId], references: [id], onDelete: SetNull)
  status           ProjectStatus     @default(BIDDING)
  billingType      BillingType       @default(FIXED_PRICE)
  netDays          Int               @default(30) // payment terms
  contractValue    BigInt // cents
  originalBidCost  BigInt // cents (total estimated cost at bid)
  billedToDate     BigInt            @default(0) // cents billed (for WIP over/under)
  targetMarginPct  Float
  retainagePct     Float             @default(10)
  percentComplete  Float? // 0..1, PM-entered; null => inferred from cost burn
  startDate        DateTime
  endDate          DateTime
  expectedEndDate  DateTime? // current projection if slipping (delay impact)
  qboJobId         String? // QBO Customer:Job id
  externalId       String? // source system id (import, field-service tool)
  customerId       String?
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  category         String? // job type, for underbid-by-type analysis
  segment          String? // service line / market segment
  performanceFlag  String? // source system's own on-track / over flag, kept for audit
  periods          ProjectPeriod[]
  invoices         Invoice[]
  bills            Bill[]
  timeEntries      TimeEntry[]
  phases           Phase[]
  budgetLines      BudgetLine[]
  costs            CostEntry[]
  changeOrders     ChangeOrder[]
  cashEvents       CashEvent[]
  milestones       Milestone[]
  laborCommitments LaborCommitment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([companyId, externalId])
  @@index([companyId, status])
}

// Optional job phases (e.g. Rough-In, Trim, Gear). Enables phase-level costing.
model Phase {
  id          String       @id @default(cuid())
  milestones  Milestone[]
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id])
  name        String
  code        String? // cost code
  sortOrder   Int          @default(0)
  budgetLines BudgetLine[]
  costs       CostEntry[]

  @@index([projectId])
}

// Budgeted cost per category (and optionally per phase). Drives over-budget
// detection and material/labor cost-increase impact.
model BudgetLine {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id])
  phaseId       String?
  phase         Phase?       @relation(fields: [phaseId], references: [id])
  category      CostCategory
  budgetedCost  BigInt // cents
  budgetedHours Int          @default(0)

  @@index([projectId, category])
}

model CostEntry {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id])
  phaseId      String?
  phase        Phase?       @relation(fields: [phaseId], references: [id])
  category     CostCategory
  costCode     String?
  docType      DocType      @default(OTHER)
  amount       BigInt // cents
  laborHours   Float? // for LABOR entries
  vendorName   String?
  incurredDate DateTime
  source       CostSource   @default(MANUAL)
  qboId        String? // source system id, for idempotent sync
  note         String?
  createdAt    DateTime     @default(now())

  @@index([projectId, category])
  @@index([qboId])
}

model ChangeOrder {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id])
  reason        String?
  contractDelta BigInt // cents
  costDelta     BigInt // cents
  status        ChangeOrderStatus @default(PENDING)
  date          DateTime
  approvedAt    DateTime?
  createdAt     DateTime          @default(now())

  @@index([projectId, status])
  /// Days this change adds to the schedule.
  timeImpactDays Int?
  /// Work started before the change was approved — unbilled exposure.
  performedBeforeApproval Boolean @default(false)
}

model CashEvent {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  projectId    String?
  project      Project?      @relation(fields: [projectId], references: [id])
  direction    CashDirection
  amount       BigInt // cents, always positive; direction carries sign
  category     CashCategory
  expectedDate DateTime
  actualDate   DateTime?
  status       CashStatus    @default(EXPECTED)
  qboId        String?
  // Identity of the obligation-and-period this event settles, e.g.
  // "OVERHEAD:<id>:2026-09". A ledger event carrying a key supersedes the
  // projection with the same key — that is how projections never double-count.
  sourceKey    String?
  createdAt    DateTime      @default(now())

  @@unique([companyId, sourceKey])
  @@index([companyId, expectedDate])
  @@index([qboId])
}

// Bank balance point-in-time (manual or bank-feed synced). Opening cash source.
model CashSnapshot {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  asOf      DateTime
  balance   BigInt // cents
  source    String   @default("MANUAL")
  createdAt DateTime @default(now())

  @@index([companyId, asOf])
}

model LaborCommitment {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  month     String // YYYY-MM
  hours     Int

  @@unique([projectId, month])
}

// A contract-defined point at which the business may invoice the client. This
// is what drives a project's contribution to the cash forecast: without it the
// timing of money coming in is inferred, and a slipped date can't ripple.
model Milestone {
  id                   String            @id @default(cuid())
  projectId            String
  project              Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                 String
  sequence             Int               @default(0)
  trigger              MilestoneTrigger  @default(DATE)
  /// Percent complete (0..1) for PERCENT_COMPLETE triggers.
  triggerValue         Float?
  phaseId              String?
  phase                Phase?            @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  expectedDate         DateTime
  /// Kept so slip is measurable rather than silently overwritten.
  originalExpectedDate DateTime
  amount               BigInt // cents
  retainagePct         Float             @default(0)
  status               MilestoneStatus   @default(PLANNED)
  billedAt             DateTime?
  paidAt               DateTime?
  qboInvoiceId         String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([projectId, expectedDate])
}

// Who actually pays this business: the GC, the school district, the property
// owner. Subcontractors' payers behave very differently from each other, and
// that behaviour — not the contract terms — is what determines when cash lands.
model Payer {
  id              String      @id @default(cuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  type            PayerType   @default(GC)
  /// Days past terms this payer typically takes. Applied on top of netDays.
  typicalDaysLate Int         @default(0)
  source          PayerSource @default(MANUAL)
  /// How many settled invoices the observed figure is based on.
  sampleSize      Int         @default(0)
  notes           String?
  projects        Project[]
  customers       Customer[]
  serviceContracts ServiceContract[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

// --- Balance sheet --------------------------------------------------------

// What the business owns. Tracked with enough structure to depreciate rather
// than just show sunk cost, so it can feed net worth and buy-vs-wait decisions.
model Asset {
  id               String        @id @default(cuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  category         AssetCategory
  purchaseDate     DateTime
  purchaseCost     BigInt // cents
  // Owner-entered current value. Anchors depreciation from `valueAsOf` — a
  // manual number always beats the computed one.
  currentValue     BigInt?
  valueAsOf        DateTime?
  usefulLifeMonths Int? // null => no straight-line decline, value holds flat
  salvageValue     BigInt        @default(0)
  disposedAt       DateTime?
  externalId       String?
  assetType        String? // truck, van, excavator, skid steer, lift, trailer...
  unitCount        Int           @default(1)
  replacementCost  BigInt?
  // Annual operating cost and use, for fleet ROI and repair-vs-replace.
  maintenanceCostAnnual BigInt?
  repairCostAnnual BigInt?
  fuelCostAnnual   BigInt?
  insuranceCostAnnual BigInt?
  utilizationPct   Float?
  downtimeDaysAnnual Int?
  liabilities      Liability[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([companyId])
}

// What the business owes. Every liability carries a payment obligation, which
// `engine/schedule` expands into projected outflows — this is never a static list.
model Liability {
  id                String        @id @default(cuid())
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  lender            String?
  kind              LiabilityKind
  originalPrincipal BigInt        @default(0) // cents
  currentBalance    BigInt // cents outstanding today
  creditLimit       BigInt? // cards / lines of credit
  interestRatePct   Float         @default(0) // APR
  paymentAmount     BigInt        @default(0) // cents per period
  paymentFrequency  Frequency     @default(MONTHLY)
  nextPaymentDate   DateTime?
  payoffDate        DateTime?
  termMonths        Int?
  endDate           DateTime? // lease end
  renewalTerms      String?
  // If a synced QBO bill's vendor contains this, the actual supersedes the
  // projected payment for that period instead of double-counting it.
  matchKeyword      String?
  externalId        String?
  collateral        String?
  originationDate   DateTime?
  maturityDate      DateTime?
  assetId           String? // the truck this loan bought, the building this lease rents
  asset             Asset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([companyId])
  @@index([assetId])
}

// The ordinary running costs that aren't debt: insurance, software, fuel,
// utilities, rent, non-job payroll. Deliberately simpler than Liability — this
// is the low-friction entry point for "what does it cost to open the doors".
model RecurringExpense {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  category     CashCategory @default(OVERHEAD)
  amount       BigInt // cents per occurrence
  frequency    Frequency    @default(MONTHLY)
  startDate    DateTime
  endDate      DateTime?
  matchKeyword String? // QBO vendor substring; see Liability.matchKeyword
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([companyId])
}

// Recurring revenue: maintenance agreements, service plans, monitoring. Simpler
// than a project on purpose — there is no bid to track against, just money that
// arrives on a schedule. Gated on the company's revenue model.
model ServiceContract {
  id               String        @id @default(cuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payerId          String?
  payer            Payer?        @relation(fields: [payerId], references: [id], onDelete: SetNull)
  name             String
  client           String
  amount           BigInt // cents per billing period
  billingFrequency Frequency     @default(MONTHLY)
  netDays          Int           @default(30)
  startDate        DateTime
  endDate          DateTime?
  renewalDate      DateTime?
  autoRenew        Boolean       @default(true)
  status           ServiceStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([companyId])
}

// --- DNRD canonical model ---------------------------------------------------
//
// DNRD owns its data model. QuickBooks, Jobber, ServiceTitan, Procore, and CSV
// imports all map into these objects; none of them define the schema.
//
// Where an object in the DNRD spec maps onto an existing model rather than a new
// one: Estimate = BudgetLine (estimate by cost category, optional hours);
// Material = CostEntry with category MATERIAL; Contract = the contract terms on
// Project; Recurring Contract = ServiceContract; Loan = Liability; Vehicle =
// Asset with assetType; Job = Project (bid work) or ServiceCallPeriod (service).

model Entity {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  isPrimary Boolean  @default(true)
  branches  Branch[]
  createdAt DateTime @default(now())

  @@index([companyId])
}

model Branch {
  id        String   @id @default(cuid())
  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name      String
  city      String?
  state     String?
  createdAt DateTime @default(now())

  @@index([entityId])
}

model Customer {
  id               String        @id @default(cuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalId       String?
  name             String
  segment          String?
  customerType     String?
  paymentTermsDays Int?
  avgDaysToPay     Float?
  active           Boolean       @default(true)
  relationshipStart DateTime?
  /// Payment-behaviour profile used by the forecast (see Payer).
  payerId          String?
  payer            Payer?        @relation(fields: [payerId], references: [id], onDelete: SetNull)
  projects         Project[]
  invoices         Invoice[]
  opportunities    Opportunity[]
  recurringRevenue RecurringRevenueEntry[]
  createdAt        DateTime      @default(now())

  @@unique([companyId, externalId])
  @@index([companyId])
}

model Vendor {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalId      String?
  name            String
  category        String?
  termsDays       Int?
  isSubcontractor Boolean  @default(false)
  bills           Bill[]
  createdAt       DateTime @default(now())

  @@unique([companyId, externalId])
  @@index([companyId])
}

model Invoice {
  id         String        @id @default(cuid())
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalId String?
  customerId String?
  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  projectId  String?
  project    Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// PROJECT, RECURRING, or SERVICE.
  source     String?
  segment    String?
  issueDate  DateTime
  dueDate    DateTime
  termsDays  Int
  amount     BigInt // cents
  paidDate   DateTime?
  status     InvoiceStatus @default(OPEN)
  payments   Payment[]
  createdAt  DateTime      @default(now())

  @@unique([companyId, externalId])
  @@index([companyId, issueDate])
  @@index([companyId, status])
}

model Payment {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       BigInt // cents
  receivedDate DateTime
  createdAt    DateTime @default(now())

  @@index([invoiceId])
}

model Bill {
  id         String     @id @default(cuid())
  companyId  String
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalId String?
  vendorId   String?
  vendor     Vendor?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  projectId  String?
  project    Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  category   String?
  billDate   DateTime
  dueDate    DateTime
  termsDays  Int
  amount     BigInt // cents
  paidDate   DateTime?
  status     BillStatus @default(OPEN)
  createdAt  DateTime   @default(now())

  @@unique([companyId, externalId])
  @@index([companyId, billDate])
}

model Crew {
  id                   String     @id @default(cuid())
  companyId            String
  company              Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                 String
  kind                 CrewKind   @default(PROJECT)
  /// Billable hours this crew can deliver per month at full utilization.
  monthlyCapacityHours Int?
  employees            Employee[]
  capacity             CrewCapacityPeriod[]
  createdAt            DateTime   @default(now())

  @@unique([companyId, name])
}

model CrewCapacityPeriod {
  id             String @id @default(cuid())
  crewId         String
  crew           Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  period         String // YYYY-MM
  capacityHours  Float?
  usedHours      Float?
  utilizationPct Float?

  @@unique([crewId, period])
}

model Employee {
  id                String      @id @default(cuid())
  companyId         String
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalId        String?
  name              String
  position          String?
  /// SALARY or HOURLY.
  payType           String
  baseAnnualCents   BigInt?
  hourlyRateCents   Int?
  crewId            String?
  crew              Crew?       @relation(fields: [crewId], references: [id], onDelete: SetNull)
  hireDate          DateTime?
  terminationDate   DateTime?
  /// Share of this person's pay that is direct job cost rather than overhead.
  cogsAllocationPct Float       @default(0)
  timeEntries       TimeEntry[]
  createdAt         DateTime    @default(now())

  @@unique([companyId, externalId])
  @@index([companyId])
}

// Hours and pay for one employee over one period. Monthly when that is all the
// source has (payroll exports); daily or per job when time tracking provides it.
model TimeEntry {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period            String // YYYY-MM
  date              DateTime?
  projectId         String?
  project           Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  regularHours      Float     @default(0)
  overtimeHours     Float     @default(0)
  regularPay        BigInt    @default(0)
  overtimePay       BigInt    @default(0)
  grossPay          BigInt // cents
  cogsAllocationPct Float?
  createdAt         DateTime  @default(now())

  @@index([companyId, period])
  @@index([employeeId, period])
}

// One row of a project's monthly WIP schedule.
model ProjectPeriod {
  id                      String  @id @default(cuid())
  projectId               String
  project                 Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  period                  String // YYYY-MM
  pctComplete             Float
  costMonth               BigInt  @default(0)
  costCumulative          BigInt  @default(0)
  revenueMonth            BigInt  @default(0)
  revenueCumulative       BigInt  @default(0)
  billedMonth             BigInt?
  billedCumulative        BigInt?
  retainageHeldCumulative BigInt?
  changeOrdersApprovedCumulative BigInt?
  changeOrdersPending     BigInt?
  revisedContract         BigInt?
  estimatedTotalCost      BigInt?
  estimatedCostToComplete BigInt?
  committedCost           BigInt?
  overbilling             BigInt?
  underbilling            BigInt?
  projectedGrossProfit    BigInt?

  @@unique([projectId, period])
}

model Opportunity {
  id                String            @id @default(cuid())
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalId        String?
  customerId        String?
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  description       String
  projectType       String?
  segment           String?
  estimatedValue    BigInt // cents
  probabilityPct    Float
  expectedMarginPct Float?
  expectedStart     DateTime?
  expectedClose     DateTime?
  status            OpportunityStatus @default(OPEN)
  lostReason        String?
  lostYear          Int?
  createdAt         DateTime          @default(now())

  @@unique([companyId, externalId])
  @@index([companyId, status])
}

// Service-call volume and revenue by segment and category per month. Ticket
// detail per job comes from field-service integrations when connected.
model ServiceCallPeriod {
  id             String  @id @default(cuid())
  companyId      String
  company        Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period         String // YYYY-MM
  segment        String
  category       String
  ticketCount    Int
  avgTicketCents BigInt
  revenue        BigInt // cents
  laborHours     Float?
  materialCost   BigInt?
  callbacks      Int?

  @@unique([companyId, period, segment, category])
}

// Recurring revenue actually billed, per customer per month. ServiceContract is
// the forward-looking agreement; this is the history churn and renewal come from.
model RecurringRevenueEntry {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  segment    String?
  period     String // YYYY-MM
  amount     BigInt // cents
  kind       String    @default("RECURRING")

  @@index([companyId, period])
  @@index([customerId, period])
}

model Budget {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year      Int
  /// REVENUE, DIRECT_COST, OPEX, CAPEX, NET_INCOME, or a GL account key.
  line      String
  budget    BigInt // cents
  actual    BigInt?

  @@unique([companyId, year, line])
}

// A forecast as it stood on a given day, kept so it can be graded against what
// actually happened.
model ForecastSnapshot {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asOf      DateTime
  kind      String // CASH_13W, CASH_12M, REVENUE_12M, BACKLOG, PAYROLL
  payload   Json
  createdAt DateTime @default(now())

  @@index([companyId, kind, asOf])
}

// Ledger accounts. Accounts from a chart of accounts carry a code; accounts
// created from statement imports carry the statement line key. Monthly amounts
// live in GlAmount, which is what the statements are built from.
model GlAccount {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key         String
  code        String?
  name        String
  statement   GlStatement
  type        GlType
  /// Finer classification: CURRENT, FIXED, LABOR, MATERIALS, DEPRECIATION, INTEREST, OWNER_COMP...
  subtype     String?
  /// Revenue rollup bucket for the service-line view.
  serviceLine String?
  sortOrder   Int         @default(0)
  amounts     GlAmount[]

  @@unique([companyId, statement, key])
  @@index([companyId, statement])
}

model GlAmount {
  id          String    @id @default(cuid())
  glAccountId String
  glAccount   GlAccount @relation(fields: [glAccountId], references: [id], onDelete: Cascade)
  period      String // YYYY-MM
  amount      BigInt // cents

  @@unique([glAccountId, period])
}

model ValuationInput {
  id        String   @id @default(cuid())
  companyId String   @unique
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asOf      DateTime
  data      Json
  createdAt DateTime @default(now())
}

// One import of a file set: what was read, written, and skipped.
model ImportRun {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source     String // CSV, QBO, PLAID...
  status     String // OK, PARTIAL, ERROR
  report     Json
  startedAt  DateTime @default(now())
  finishedAt DateTime?

  @@index([companyId, startedAt])
}

// --- Integrations ---------------------------------------------------------

model QboConnection {
  id           String   @id @default(cuid())
  companyId    String   @unique
  company      Company  @relation(fields: [companyId], references: [id])
  realmId      String // QBO company id
  accessToken  String
  refreshToken String
  expiresAt    DateTime // access-token expiry
  environment  String   @default("production") // or "sandbox"
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SyncLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  provider   String   @default("QBO")
  kind       String // FULL, INCREMENTAL, INVOICES, BILLS, TIME, etc.
  status     String // OK, ERROR
  counts     Json? // { invoices: 12, bills: 30, ... }
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  error      String?

  @@index([companyId, startedAt])
}

