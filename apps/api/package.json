{
  "name": "@plumb/api",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:acceptance": "ACCEPTANCE=1 vitest run test/acceptance.test.ts",
    "scoreboard": "tsx src/acceptance/scoreboard.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@fastify/cookie": "^10.0.0",
    "@fastify/cors": "^10.0.0",
    "@plumb/db": "workspace:*",
    "@plumb/engine": "workspace:*",
    "@plumb/qbo": "workspace:*",
    "@plumb/shared": "workspace:*",
    "fastify": "^5.1.0",
    "node-cron": "^3.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
